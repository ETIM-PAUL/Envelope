{
  "name": "myapp",
  "workspaces": [
    "packages/*",
    "relayer",
    "scripts"
  ],
  "scripts": {
    "anchor": "cd anchor && anchor",
    "anchor:build": "cd anchor && anchor build",
    "anchor:deploy:devnet": "cd anchor && anchor build && anchor program deploy --provider.cluster devnet",
    "anchor:deploy:localnet": "cd anchor && anchor build && anchor program deploy --provider.cluster localnet",
    "anchor:localnet": "cd anchor && anchor localnet",
    "anchor:setup": "cd anchor && anchor keys sync && anchor build && cd .. && npm run codama:js",
    "anchor:test": "cd anchor && anchor test",
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "codama:js": "npm run codama:js:helloWorld && npm run codama:js:envelopeVault && npm run codama:js:envelopeStake",
    "codama:js:helloWorld": "CODAMA_PROGRAM=helloWorld codama run js -c ./anchor/codama.mjs",
    "codama:js:envelopeVault": "CODAMA_PROGRAM=envelopeVault codama run js -c ./anchor/codama.mjs",
    "codama:js:envelopeStake": "CODAMA_PROGRAM=envelopeStake codama run js -c ./anchor/codama.mjs",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "web": "expo start --web",
    "devnet:keys": "tsx scripts/setup-devnet-keys.ts",
    "devnet:airdrop": "tsx scripts/airdrop.ts",
    "devnet:mints": "tsx scripts/setup-mints.ts",
    "devnet:faucet": "tsx scripts/faucet.ts",
    "devnet:roundtrip": "tsx scripts/roundtrip.ts",
    "devnet:vault-roundtrip": "tsx scripts/vault-roundtrip.ts",
    "devnet:pot-roundtrip": "tsx scripts/pot-roundtrip.ts",
    "devnet:stake-roundtrip": "tsx scripts/stake-roundtrip.ts",
    "devnet:withdraw-roundtrip": "tsx scripts/withdraw-roundtrip.ts",
    "cbridge:build": "npm run build -w packages/cbridge",
    "cbridge:typecheck": "npm run typecheck -w packages/cbridge",
    "rn-confidential:typecheck": "npm run typecheck -w packages/rn-confidential",
    "relayer:dev": "npm run dev -w relayer",
    "relayer:typecheck": "npm run typecheck -w relayer",
    "relayer:test-policy": "tsx scripts/test-relayer.ts",
    "android:apk": "bash scripts/build-apk.sh",
    "android:apk:arm64": "bash scripts/build-apk.sh arm64-v8a",
    "devnet:cskr": "tsx scripts/setup-cskr.ts",
    "devnet:cskr-roundtrip": "tsx scripts/cskr-roundtrip.ts",
    "devnet:bridge-e2e": "tsx scripts/bridge-cskr-e2e.ts",
    "devnet:pass": "tsx scripts/setup-pass.ts",
    "relayer:test-fuel": "tsx scripts/test-fuel.ts",
    "test:unit": "vitest run src",
    "cbridge:verify-zk-sdk": "tsx packages/cbridge/scripts/compare-zk-sdk.ts",
    "relayer:test-attacks": "tsx scripts/test-relayer.ts && tsx scripts/fuzz-relayer-policy.ts"
  },
  "displayName": "Expo Kit Anchor example",
  "description": "A template for building a Solana mobile app with Expo, React Native, Solana Kit, Anchor, and Uniwind.",
  "usecase": "Mobile",
  "keywords": [
    "anchor",
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-kit",
    "tailwind",
    "uniwind"
  ],
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@envelope/cbridge": "*",
    "@envelope/rn-confidential": "*",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.5",
    "@expo/vector-icons": "^15.0.2",
    "@solana-program/token": "^0.17.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana/kit": "^8.3.0",
    "@tanstack/react-query": "^5.90.7",
    "@wallet-ui/react-native-kit": "^4.3.0",
    "expo": "~57.0.6",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "^57.0.6",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "~19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "^14.0.1",
    "tailwindcss": "~4.1.16",
    "uniwind": "~1.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@codama/cli": "^1.6.0",
    "@codama/nodes-from-anchor": "^1.5.3",
    "@codama/renderers-js": "^2.3.1",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-native-reanimated": "4.5.4",
    "react-native-worklets": "0.10.4",
    "uuid": "^11.1.1"
  },
  "resolutions": {
    "react-native-reanimated": "4.5.4",
    "react-native-worklets": "0.10.4",
    "uuid": "^11.1.1"
  },
  "private": true
}
