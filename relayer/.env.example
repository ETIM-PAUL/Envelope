HELIUS_API_KEY=
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Path to the relayer's fee-payer keypair (generated by `npm run devnet:keys` -> .keys/relayer.json).
RELAYER_KEYPAIR_PATH=../.keys/relayer.json

# Verifies incoming Helius webhook calls (checked against the request's Authorization header).
# Leave unset to accept unauthenticated webhook calls (fine for local devnet testing only).
HELIUS_WEBHOOK_SECRET=

# HTTP port the relayer listens on.
PORT=8787

# Policy knobs (see src/policy.ts) — both have working defaults, only set these to override them.
# Priority-fee cap the relayer will co-sign for, in microlamports per compute unit.
MAX_COMPUTE_UNIT_PRICE_MICROLAMPORTS=200000
# Minimum SKR (base units) a Free-tier wallet must pay the relayer per relayed transaction.
FREE_TIER_FEE_AMOUNT=1000

# Per-wallet rate limit: at most this many /relay requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
