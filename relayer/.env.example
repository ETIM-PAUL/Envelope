HELIUS_API_KEY=
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Path to the relayer's fee-payer keypair (generated by `npm run devnet:keys` -> .keys/relayer.json).
RELAYER_KEYPAIR_PATH=../.keys/relayer.json

# Verifies incoming Helius webhook calls (checked against the request's Authorization header).
# Leave unset to accept unauthenticated webhook calls (fine for local devnet testing only).
HELIUS_WEBHOOK_SECRET=

# HTTP port the relayer listens on.
PORT=8787

# Policy knobs (see src/policy.ts) — both have working defaults, only set these to override them.
# Priority-fee cap the relayer will co-sign for, in microlamports per compute unit.
MAX_COMPUTE_UNIT_PRICE_MICROLAMPORTS=200000
# SKR (base units, 6 decimals) a Free-tier wallet pays the relayer per private transfer: 1 SKR.
FREE_TIER_FEE_AMOUNT=1000000

# Per-wallet rate limit: at most this many /relay requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# SKR fuel (src/fuel.ts) — refills a wallet's gas tank with SOL so it never needs its own.
# FUEL_ENABLED=true
# FUEL_REFILL_BELOW_LAMPORTS=10000000   # refill only below 0.01 SOL
# FUEL_TOP_UP_TO_LAMPORTS=25000000      # ...up to 0.025 SOL
# FUEL_PRICE_SKR=2000000                # Free tier pays 2 SKR per refill (Members: included)
# FUEL_MAX_REFILLS_PER_DAY=3
# FUEL_LEDGER_PATH=                     # default relayer/.data/fuel.json


# Gift links: where the /gift page's "Get Envelope" button points (the release APK by default).
# APP_DOWNLOAD_URL=https://github.com/ETIM-PAUL/Envelope/releases/latest/download/envelope.apk
