            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "amount",
            "type": "u64"
          },
          {
            "name": "unlock_requested_at",
            "docs": [
              "0 when no unstake has been requested; otherwise the unix timestamp `request_unstake` was",
              "called at. Tier drops to `Free` the instant this is set — see `tier::tier_for_stake`."
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    }
