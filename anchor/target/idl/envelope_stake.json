          {
            "name": "vault_skr",
            "type": "pubkey"
          },
          {
            "name": "member_threshold",
            "type": "u64"
          },
          {
            "name": "business_threshold",
            "type": "u64"
          },
          {
            "name": "cooldown_secs",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "StakePosition",
      "type": {
        "kind": "struct",
        "fields": [
