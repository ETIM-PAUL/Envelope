# Helius devnet RPC — sign up at https://helius.dev, create a devnet API key.
HELIUS_API_KEY=
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Same URL, exposed to the Expo app bundle (EXPO_PUBLIC_ vars are inlined at build time).
EXPO_PUBLIC_HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# The relayer's base URL. Leave unset in development: the app then reaches the relayer on the same
# machine as the Metro dev server (port 8787), which works from an emulator and from a phone on
# the same Wi-Fi alike (see src/config/relayer.ts). Set it only for a relayer hosted elsewhere.
# EXPO_PUBLIC_RELAYER_URL=https://relayer.example.com
