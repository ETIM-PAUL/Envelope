# Helius devnet RPC — sign up at https://helius.dev, create a devnet API key.
HELIUS_API_KEY=
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Same URL, exposed to the Expo app bundle (EXPO_PUBLIC_ vars are inlined at build time).
EXPO_PUBLIC_HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# The relayer's base URL (see relayer/README or `npm run relayer:dev`). Defaults to
# http://localhost:8787, which only reaches a relayer running on the host machine from an iOS
# simulator or a web build — an Android emulator needs http://10.0.2.2:8787 instead, and a
# physical device needs your machine's LAN IP.
EXPO_PUBLIC_RELAYER_URL=http://localhost:8787
