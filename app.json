{
  "expo": {
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1116",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "Envelope",
    "slug": "myapp",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.anonymous.myapp",
      "backgroundColor": "#0F1116",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0F1116"
      }
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "backgroundColor": "#0F1116",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ]
  }
}
